{
  "readOnly": true,
  "allowedLeadingKeywords": ["SELECT", "EXPLAIN", "WITH", "SHOW"],
  "forbiddenKeywords": [
    "INSERT", "UPDATE", "DELETE", "DROP", "ALTER", "TRUNCATE",
    "CREATE", "GRANT", "REVOKE", "COPY", "VACUUM", "REINDEX",
    "CLUSTER", "MERGE", "CALL"
  ],
  "wrapInReadOnlyTx": true,
  "statementTimeoutMs": 10000,
  "connectTimeoutMs": 10000,
  "defaultLimit": 100,
  "maxRows": 1000,
  "cellMaxLength": 80,
  "ssh": {
    "controlPersistSeconds": 600,
    "connectTimeoutSeconds": 10,
    "serverAliveIntervalSeconds": 5,
    "serverAliveCountMax": 2,
    "pgConnectTimeoutMs": 20000
  },
  "targets": {}
}
